# ============================================================
# Cloud BÊTA local — OPT-IN UNIQUEMENT
# ============================================================
# Copier vers .env.cloud-beta.local (gitignored).
# Lancer : DOCMIND_CLOUD_BETA=1 npm run dev
#
# NE PAS utiliser pour les E2E Playwright (utiliser E2E_TARGET=staging).
# NE PAS confondre avec Production Vercel.

NEXT_PUBLIC_APP_ENV=beta
DOCMIND_STORAGE=persistent
DOCMIND_FS_FALLBACK=0

# Supabase / Postgres / S3 / Redis / Stripe (clés staging/bêta — pas prod Vercel)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# REDIS_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_BASIQUE=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_EXTRA=
# STRIPE_WEBHOOK_SECRET=
# QUOTA_FREE_ANALYZE=5
