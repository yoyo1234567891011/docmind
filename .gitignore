# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/report
/e2e/test-results
/e2e/fixtures/sample.pdf
/chaos/report
/chaos/test-results
/playwright-report
/test-results

# next.js
/.next/
/.next-build/
/.next-e2e/
/.next-chaos/
/.next-build.build.lock
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.e2e.staging.example
!.env.development.local.example
!.env.cloud-beta.local.example
!.env.production.example

# local uploads / temp files
/uploads/*
!/uploads/.gitkeep
/data/history/*
!/data/history/.gitkeep
/data/admin/*
!/data/admin/.gitkeep
/data/users/*
!/data/users/.gitkeep
/data-e2e/
/data/system/*
!/data/system/.gitkeep
/backups/*
!/backups/.gitkeep
/reports/*
!/reports/.gitkeep
/tmp
/logs
*.log

# Corpus réel : originaux + mappings PII (ne jamais committer)
/corpus/inbox/**
!/corpus/inbox/.gitkeep
!/corpus/inbox/README.md
/corpus/manifest.json
**/real-anonymized/**/*.replacements.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

.supabase-db-password.local
.supabase-keys.local.json

.env*.local

.env.vercel*
