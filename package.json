{
  "name": "docmind",
  "version": "0.1.0",
  "private": true,
  "description": "DocMind - analyse de PDF avec IA locale (Ollama)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev --turbopack -H 0.0.0.0 -p 3000",
    "build": "node scripts/build-safe.mjs",
    "start": "node scripts/start-safe.mjs",
    "lint": "eslint",
    "evaluate": "tsx --tsconfig tsconfig.json scripts/evaluate.ts",
    "evaluate:quick": "tsx --tsconfig tsconfig.json scripts/evaluate.ts --limit 3",
    "benchmark": "tsx --tsconfig tsconfig.json scripts/benchmark/run.ts",
    "benchmark:quick": "tsx --tsconfig tsconfig.json scripts/benchmark/run.ts --limit 1 --providers docmind",
    "test:docs": "tsx --tsconfig tsconfig.json scripts/eval-documents.ts",
    "test:docs:quick": "tsx --tsconfig tsconfig.json scripts/eval-documents.ts --limit 3",
    "test:p0": "tsx --tsconfig tsconfig.json scripts/test-p0-optimizations.ts",
    "test:reasoning": "tsx --tsconfig tsconfig.json scripts/test-reasoning-risks.ts",
    "test:agents": "tsx --tsconfig tsconfig.json scripts/test-multi-agents.ts",
    "test:agent-eval": "tsx --tsconfig tsconfig.json scripts/test-agent-eval.ts",
    "test:citations": "tsx --tsconfig tsconfig.json scripts/test-citations.ts",
    "test:knowledge": "tsx --tsconfig tsconfig.json scripts/test-knowledge.ts",
    "test:memory": "tsx --tsconfig tsconfig.json scripts/test-document-memory.ts",
    "test:memory-p0": "tsx --tsconfig tsconfig.json scripts/test-memory-p0.ts",
    "test:memory-p1": "tsx --tsconfig tsconfig.json scripts/test-memory-p1.ts",
    "test:memory-p2": "tsx --tsconfig tsconfig.json scripts/test-memory-p2.ts",
    "test:memory-p3": "tsx --tsconfig tsconfig.json scripts/test-memory-p3.ts",
    "test:memory-p4": "tsx --tsconfig tsconfig.json scripts/test-memory-p4.ts",
    "test:insights": "tsx --tsconfig tsconfig.json scripts/test-insights-product.ts",
    "test:subscriptions-display": "tsx --tsconfig tsconfig.json scripts/test-subscriptions-display.ts",
    "migrate:memory-p0": "tsx --tsconfig tsconfig.json scripts/migrate-memory-p0.ts",
    "migrate:persistent": "tsx --tsconfig tsconfig.json scripts/migrate-fs-to-persistent.ts",
    "validate:persistent": "tsx --tsconfig tsconfig.json scripts/validate-persistent-storage.ts",
    "validate:prod-gate": "tsx --tsconfig tsconfig.json scripts/validate-production-gate.ts",
    "measure:ollama": "tsx --tsconfig tsconfig.json scripts/measure-ollama-latency.ts",
    "test:search": "tsx --tsconfig tsconfig.json scripts/test-smart-search.ts",
    "test:quota-upgrade": "tsx --tsconfig tsconfig.json scripts/test-quota-upgrade-reset.ts",
    "test:alerts": "tsx --tsconfig tsconfig.json scripts/test-alerts-engine.ts",
    "test:history-cascade": "tsx --tsconfig tsconfig.json scripts/test-history-cascade-delete.ts",
    "test:letter": "tsx --tsconfig tsconfig.json scripts/test-letter-agent.ts",
    "test:letter-quota": "tsx --tsconfig tsconfig.json scripts/test-letter-quota.ts",
    "test:manager": "tsx --tsconfig tsconfig.json scripts/test-document-manager.ts",
    "test:auth": "tsx --tsconfig tsconfig.json scripts/test-auth-isolation.ts",
    "test:llm-health": "tsx --tsconfig tsconfig.json scripts/test-llm-health.ts",
    "test:billing": "tsx --tsconfig tsconfig.json scripts/test-billing.ts",
    "test:production-ops": "tsx --tsconfig tsconfig.json scripts/test-production-ops.ts",
    "test:zero-defect": "tsx --tsconfig tsconfig.json scripts/test-zero-defect-fixes.ts",
    "test:cto-proofs": "tsx --tsconfig tsconfig.json scripts/test-cto-repro-proofs.ts",
    "test:distributed-locks": "tsx --tsconfig tsconfig.json scripts/test-distributed-locks.ts",
    "test:upload-tx": "tsx --tsconfig tsconfig.json scripts/test-upload-s3-pg-transaction.ts",
    "test:analysis-jobs": "tsx --tsconfig tsconfig.json scripts/test-analysis-jobs.ts",
    "test:analysis-llm-contract": "tsx --tsconfig tsconfig.json scripts/test-analysis-llm-contract.ts",
    "test:analysis-job-metrics": "tsx --tsconfig tsconfig.json scripts/test-analysis-job-metrics.ts",
    "test:analysis-job-drain": "tsx --tsconfig tsconfig.json scripts/test-analysis-job-drain.ts",
    "test:analysis-job-crash": "tsx --tsconfig tsconfig.json scripts/test-analysis-job-crash-recovery.ts",
    "test:analysis-job-crash-process": "tsx --tsconfig tsconfig.json scripts/test-analysis-job-crash-process.ts",
    "test:analysis-job-crash-pg": "tsx --tsconfig tsconfig.json scripts/test-analysis-job-crash-recovery-pg.ts",
    "jobs:drain": "tsx --tsconfig tsconfig.json scripts/drain-analysis-jobs.ts",
    "jobs:drain:watch": "tsx --tsconfig tsconfig.json scripts/drain-analysis-jobs.ts --watch --interval 90 --max 3",
    "jobs:drain:http": "tsx --tsconfig tsconfig.json scripts/drain-analysis-jobs.ts --via-http --max 3",
    "jobs:worker": "powershell -ExecutionPolicy Bypass -File scripts/start-analysis-worker.ps1",
    "test:persistent-backup": "tsx --tsconfig tsconfig.json scripts/test-persistent-backup-restore.ts",
    "test:stripe-webhook-concurrency": "tsx --tsconfig tsconfig.json scripts/test-stripe-webhook-concurrency.ts",
    "test:stripe-webhook-subscription-created": "tsx --tsconfig tsconfig.json scripts/test-stripe-webhook-subscription-created.ts",
    "backup:run": "tsx --tsconfig tsconfig.json scripts/backup-run.ts",
    "backup:verify": "tsx --tsconfig tsconfig.json scripts/backup-verify.ts",
    "backup:restore": "tsx --tsconfig tsconfig.json scripts/backup-restore.ts",
    "monitor:check": "tsx --tsconfig tsconfig.json scripts/monitor-check.ts",
    "bench:p0": "tsx --tsconfig tsconfig.json scripts/bench-p0-optimizations.ts",
    "test:regression": "npm run test:p0 && npm run test:reasoning && npm run test:agents && npm run test:agent-eval && npm run test:citations && npm run test:knowledge && npm run test:memory && npm run test:memory-p0 && npm run test:memory-p1 && npm run test:memory-p2 && npm run test:memory-p3 && npm run test:memory-p4 && npm run test:insights && npm run test:search && npm run test:alerts && npm run test:letter && npm run test:manager && npm run test:auth && npm run test:billing && npm run test:anonymize && npm run test:analytics && npm run test:production-ops && npm run test:zero-defect && npm run test:distributed-locks && npm run test:upload-tx && npm run test:analysis-jobs && npm run test:analysis-llm-contract && npm run test:analysis-job-metrics && npm run test:analysis-job-drain && npm run test:analysis-job-crash && npm run test:analysis-job-crash-process && npm run test:persistent-backup && npm run test:stripe-webhook-concurrency && npm run test:stripe-webhook-subscription-created && npx tsc --noEmit && npm run lint",
    "generate:docs": "node scripts/generate-test-documents.mjs",
    "generate:docs:extra": "node scripts/generate-extra-test-documents.mjs",
    "generate:pdfs": "node scripts/convert-md-to-pdf.mjs",
    "corpus:import": "tsx --tsconfig tsconfig.json scripts/import-corpus-document.ts",
    "test:anonymize": "tsx --tsconfig tsconfig.json scripts/test-anonymize.ts",
    "test:analytics": "tsx --tsconfig tsconfig.json scripts/test-analytics.ts",
    "evaluate:real": "tsx --tsconfig tsconfig.json scripts/evaluate.ts --corpus real",
    "test:docs:real": "tsx --tsconfig tsconfig.json scripts/eval-documents.ts --corpus real",
    "load:sim": "tsx --tsconfig tsconfig.json scripts/load-simulator/run.ts",
    "load:sim:model": "tsx --tsconfig tsconfig.json scripts/load-simulator/run.ts --mode model",
    "load:test": "tsx --tsconfig tsconfig.json scripts/load-simulator/run.ts --mode model --users 100,500,1000,5000,10000",
    "load:test:hybrid": "tsx --tsconfig tsconfig.json scripts/load-simulator/run.ts --mode hybrid --users 100,500,1000,5000,10000",
    "load:test:live": "tsx --tsconfig tsconfig.json scripts/load-simulator/run.ts --mode live --users 100,500,1000,5000,10000",
    "finance:sim": "tsx --tsconfig tsconfig.json scripts/finance-simulator/run.ts",
    "finance:sim:quick": "tsx --tsconfig tsconfig.json scripts/finance-simulator/run.ts --users 100,500,1000,5000,10000",
    "e2e:prepare": "node e2e/fixtures/generate-sample-pdf.mjs",
    "e2e": "npm run e2e:prepare && playwright test",
    "e2e:ui": "npm run e2e:prepare && playwright test --ui",
    "test:e2e": "npm run e2e",
    "chaos:unit": "tsx --tsconfig tsconfig.json chaos/run.ts",
    "chaos:e2e": "npm run e2e:prepare && playwright test -c playwright.chaos.config.ts",
    "chaos": "npm run chaos:unit && npm run chaos:e2e",
    "test:chaos": "npm run chaos"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.1",
    "next": "15.5.20",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^22.3.2",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
