# ============================================================
# Développement LOCAL isolé (prioritaire sur .env.local en `next dev`)
# ============================================================
# Copier vers .env.development.local (gitignored) si vous devez
# forcer l'isolation alors que .env.local contient encore du cloud.
#
# Recommandé : plutôt utiliser npm run dev (scripts/local-dev-env.mjs)
# qui applique ces overrides au runtime sans toucher Production.

NEXT_PUBLIC_APP_ENV=development
DOCMIND_STORAGE=fs
DOCMIND_FS_FALLBACK=0
DOCMIND_DATA_DIR=data

# LLM local
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:120b

# Backends cloud — laisser vides en dev local standard
# DATABASE_URL=
# REDIS_URL=
# S3_BUCKET=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# GROQ_API_KEY=
