# ─── DocMind — configuration PRODUCTION / BÊTA ─────────────────────────────
# Copier vers .env.production.local ou injecter via l'hébergeur.

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=beta
NEXT_PUBLIC_APP_VERSION=0.1.0-beta

# Auth Supabase (obligatoire en production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
ADMIN_EMAILS=toi@exemple.com

# Ollama (machine locale ou host autorisé)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_PROFILE=mistral
OLLAMA_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_ALLOWED_HOSTS=

# Maintenance (true = page /maintenance + API 503)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=DocMind est en maintenance. Réessayez bientôt.
# Secret pour bypass admin : /?maintenance_bypass=SECRET
# MAINTENANCE_BYPASS_SECRET=change-me-long-random

# Feedback / signalements bêta
BETA_FEEDBACK_ENABLED=true

# URL publique (Checkout / Portal Stripe)
NEXT_PUBLIC_APP_URL=https://votre-domaine.example

# Stripe (obligatoire pour monétiser en prod — 4 prices)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_BASIQUE=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_EXTRA=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
QUOTA_FREE_ANALYZE=5
# Endpoint webhook: POST https://votre-domaine.example/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed

# Écoute locale par défaut (ne pas exposer 0.0.0.0 sans reverse-proxy)
HOST=127.0.0.1
PORT=3000

# Ne pas activer EVAL_API_KEY sur une instance publique
# EVAL_API_KEY=
