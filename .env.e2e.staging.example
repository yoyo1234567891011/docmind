# ============================================================
# E2E STAGING — JAMAIS la production
# ============================================================
# Copier vers : .env.e2e.staging.local  (gitignored)
# Puis : npm run e2e:dashboard:staging
#
# Ce fichier configure UNIQUEMENT le LLM cloud pour Playwright.
# Stockage E2E = FS local isolé (pas de PG/S3/Stripe/Supabase prod).
#
# Ne pas y coller DATABASE_URL / S3 / Stripe / Supabase de production.

E2E_TARGET=staging

# Clé Groq dédiée staging (recommandé). Sinon E2E_STAGING_GROQ_API_KEY.
E2E_STAGING_GROQ_API_KEY=

# Optionnel — overrides (défauts dans e2e/helpers/env-target.ts)
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_BASE_URL=https://api.groq.com/openai/v1

# ============================================================
# LOCAL (référence — ne pas mettre ici ; utilise .env.local)
# ============================================================
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# ============================================================
# PRODUCTION / BÊTA Vercel (référence — NE PAS COPIER ICI)
# ============================================================
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=<secret Vercel>
# DOCMIND_STORAGE=persistent
# DATABASE_URL=<PG prod>
