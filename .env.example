# Environnement applicatif : development | beta | production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=0.1.0-beta

# Maintenance (true/1 pour activer)
# MAINTENANCE_MODE=false
# MAINTENANCE_MESSAGE=DocMind est en maintenance.
# MAINTENANCE_BYPASS_SECRET=

# Watchdog file d’analyse — OBLIGATOIRE en beta/prod (HTTP cron)
# Local : npm run jobs:drain:watch   |   Beta : POST /api/cron/drain-analysis-jobs toutes les 1–2 min
# CRON_SECRET=long-random-secret

# Feedback / signalements
BETA_FEEDBACK_ENABLED=true

# Optimisations P0 (1=on, 0=off) — défauts dans src/config/optimizations.ts
# OPT_ANALYSIS_CACHE=1
# OPT_CONDITIONAL_JSON_RETRY=1
# OPT_OLLAMA_KEEP_ALIVE=1

# Mémoire P4 — vérif LLM des relations ambiguës (0,70–0,84), hors chemin critique
# MEMORY_RELATION_LLM_VERIFY=0

# Ollama (local LLM) — utilisé si aucune clé cloud LLM_* / GROQ_* / MISTRAL_*
OLLAMA_BASE_URL=http://127.0.0.1:11434

# LLM cloud OpenAI-compatible (Vercel beta/prod — pas de tunnel PC)
# Dès qu’une clé est définie, generate() utilise l’API cloud (Groq recommandé, gratuit).
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# LLM_MODEL=llama-3.1-8b-instant

# Prefer switching models in: src/config/ollama-models.ts (ACTIVE_MODEL_PROFILE)
# Optional override of that profile without editing the file:
# OLLAMA_PROFILE=qwen|llama|mistral|deepseek

# Optional hard overrides (bypass profile chat tag):
# OLLAMA_MODEL=qwen3
# OLLAMA_MODEL_CLASSIFY=qwen3
# OLLAMA_MODEL_ANALYZE=qwen3
# OLLAMA_MODEL_REPLY=qwen3
# OLLAMA_MODEL_SEARCH=qwen3
# OLLAMA_EMBED_MODEL=nomic-embed-text

# URL du serveur Next pendant l'évaluation
EVAL_BASE_URL=http://127.0.0.1:3000

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Clé optionnelle pour npm run evaluate (header x-eval-api-key)
# Ne donne PAS accès admin. Utiliser une valeur longue et unique.
# En production/beta/staging : ignorée sauf EVAL_ALLOW_IN_DEPLOY=1
# EVAL_API_KEY=dev-eval-secret
# EVAL_ALLOW_IN_DEPLOY=0

# Emails autorisés pour /api/admin/* (séparés par des virgules)
# Obligatoire dès que Supabase est configuré.
# ADMIN_EMAILS=toi@exemple.com

# URL publique de l’app (OBLIGATOIRE en production/beta — Checkout / Portal / SEO)
# NEXT_PUBLIC_APP_URL=https://app.example.com

# Strict boot : refuse le démarrage si env prod incomplète
# DOCMIND_SKIP_ENV_ASSERT=1
# ATTENTION: en production/beta/staging, SKIP est IGNORÉ — les protections
# (STORAGE=persistent, FS_FALLBACK=0, REDIS, Stripe, S3, Supabase) restent obligatoires.
# SKIP ne sert qu’en development (CI locale / scripts).

# Détails /api/health?details=1 (header x-health-token)
# HEALTH_DETAILS_TOKEN=

# Suppression Auth Supabase lors de DELETE compte (OBLIGATOIRE en production)
# SUPABASE_SERVICE_ROLE_KEY=

# Infos légales (pages publiques)
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=contact@votre-domaine.fr
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=Votre Société SAS
# NEXT_PUBLIC_LEGAL_ADDRESS=1 rue Exemple, 75000 Paris

# Stripe — offre Premium
# En local sans Stripe : Premium ouvert (dev) sauf si BILLING_ENTITLEMENTS_FAIL_OPEN=0
# En production/beta sans Stripe : fail-closed (Gratuit) — ne jamais déployer sans clés.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BILLING_ENTITLEMENTS_FAIL_OPEN=1
# Webhook endpoint: POST /api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created|updated|deleted,
#   invoice.paid, invoice.payment_failed, invoice.payment_action_required,
#   charge.refunded, refund.created, charge.dispute.created, charge.dispute.funds_withdrawn
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook

# Hosts Ollama supplémentaires (défaut: 127.0.0.1, localhost)
# OLLAMA_ALLOWED_HOSTS=

# Analytics — estimation coût / analyse (EUR)
# ANALYTICS_GPU_HOUR_EUR=0.12
# ANALYTICS_TOKEN_MILLION_EUR=0

# Quotas mensuels métier Free / Premium (-1 = illimité)
# QUOTA_FREE_ANALYZE=20
# QUOTA_FREE_UPLOAD=40
# QUOTA_FREE_LETTER=0
# QUOTA_FREE_SEARCH=200
# QUOTA_PREMIUM_ANALYZE=200
# QUOTA_PREMIUM_UPLOAD=500
# QUOTA_PREMIUM_LETTER=100
# QUOTA_PREMIUM_SEARCH=2000

# Persistance production (obligatoire en beta/production/staging)
# DOCMIND_STORAGE=persistent
# DOCMIND_FS_FALLBACK=0
# DATABASE_URL=postgresql://user:pass@host:5432/docmind
# REDIS_URL=redis://host:6379
# S3_BUCKET=docmind-pdfs
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optionnel — auth S3 Supabase par session (ref + anon + service_role JWT)
# S3_SESSION_TOKEN=
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# AWS_REGION=eu-west-1
# S3_FORCE_PATH_STYLE=1
# PG_POOL_MAX=10
# PG_SSL=1
# Staging local Supabase / cert auto-signé :
# PG_SSL_REJECT_UNAUTHORIZED=0
# Migration FS → PG/S3 : npm run migrate:persistent
# Validation : npm run validate:persistent
# Fallback FS→PG/Redis : opt-in local UNIQUEMENT (défaut off). Interdit en déployé.
# DOCMIND_FS_FALLBACK=1
# Dual-write PG+FS (rollback) — optionnel, local uniquement
# DOCMIND_FS_DUAL_WRITE=0

# Sauvegardes (npm run backup:run | verify | restore) — docs/BACKUP-RESTORE.md
# BACKUP_KEEP=14

# Monitoring ops (npm run monitor:check) — seuils + webhook alertes
# MONITOR_MIN_SUCCESS_RATE=0.5
# MONITOR_MAX_AVG_DURATION_MS=300000
# MONITOR_MAX_AVG_WAIT_MS=120000
# MONITOR_MAX_SERVER_ERRORS=20
# MONITOR_REQUIRE_OLLAMA=1
# MONITORING_WEBHOOK_URL=https://hooks.example.com/docmind

# Chaos testing (npm run chaos) — JAMAIS en production sauf drill explicite
# DOCMIND_CHAOS=1
# DOCMIND_CHAOS_FAULTS=ollama_down,redis_down,postgres_down,s3_down,stripe_timeout
# DOCMIND_CHAOS_ALLOW_IN_PROD=0
# DOCMIND_CHAOS_STRIPE_DELAY_MS=50

# Benchmark concurrentiel (npm run benchmark) — clés optionnelles
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# BENCHMARK_OPENAI_MODEL=gpt-4o
# BENCHMARK_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# BENCHMARK_GEMINI_MODEL=gemini-2.0-flash
# BENCHMARK_MISTRAL_MODEL=mistral-large-latest
# BENCHMARK_LIMIT=2
